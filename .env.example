# Create a bot with @BotFather. Keep this file private as .env.
BOT_TOKEN=

# Comma-separated Telegram group IDs where agent messages are accepted, e.g.
# ASKTG_AGENT_GROUP_IDS=-1001234567890
ASKTG_AGENT_GROUP_IDS=

# Local Codex runner. Leave disabled until trusted IDs and repo path are set.
ASKTG_AGENT_AUTO_RUN=0
ASKTG_AGENT_ID=
ASKTG_AGENT_BOT_USERNAME=
ASKTG_AGENT_TRUSTED_SENDERS=
ASKTG_AGENT_PEER_BOTS=
ASKTG_AGENT_REPO=
ASKTG_AGENT_TIMEOUT_SECONDS=7200
